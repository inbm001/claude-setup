{
  "_comment": "~/.claude/settings.json 의 permissions 블록만 발췌. 기존 settings.json 에 이 키를 붙여넣을 것. 경로의 inbm_mini 는 각 맥의 사용자명으로 바꿀 것.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)",
      "Bash(grep:*)", "Bash(rg:*)", "Bash(find:*)", "Bash(tree:*)", "Bash(file:*)",
      "Bash(stat:*)", "Bash(pwd)", "Bash(which:*)", "Bash(echo:*)", "Bash(diff:*)",
      "Bash(sed:*)", "Bash(awk:*)", "Bash(sort:*)", "Bash(uniq:*)", "Bash(jq:*)",
      "Bash(mkdir:*)", "Bash(touch:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(rm:*)",
      "Bash(chmod:*)", "Bash(osascript:*)", "Bash(open:*)", "Bash(sh:*)", "Bash(bash:*)",
      "Bash(basename:*)", "Bash(dirname:*)", "Bash(date:*)", "Bash(ps:*)", "Bash(defaults read:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git branch:*)", "Bash(git remote:*)", "Bash(git blame:*)",
      "Bash(git stash list:*)", "Bash(git check-ignore:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git checkout:*)", "Bash(git switch:*)",
      "Bash(cargo build:*)", "Bash(cargo check:*)", "Bash(cargo test:*)",
      "Bash(cargo run:*)", "Bash(cargo fmt:*)", "Bash(cargo clippy:*)",
      "Bash(npm run:*)", "Bash(npm test:*)", "Bash(npm ci:*)", "Bash(npx tsc:*)",
      "Bash(pnpm:*)", "Bash(yarn:*)",
      "Bash(python3:*)", "Bash(pytest:*)", "Bash(uv:*)", "Bash(pip list:*)",
      "Read(//Users/inbm_mini/**)", "WebSearch",
      "Write(//Users/inbm_mini/.claude/**)", "Edit(//Users/inbm_mini/.claude/**)",
      "Write(//Users/inbm_mini/Documents/**)", "Edit(//Users/inbm_mini/Documents/**)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(//Users/inbm_mini/**/.env)",
      "Read(//Users/inbm_mini/.ssh/**)",
      "Read(//Users/inbm_mini/.aws/**)"
    ]
  }
}
